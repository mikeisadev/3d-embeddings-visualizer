# Embedding Explorer 3D – copy this file to .env (never commit .env).
#   cp .env.example .env

# --- Vector database (L17) --------------------------------------------------------------
# Option A (default): the L17 database published on the host, port 5432.
VIZ_DB_URL=jdbc:postgresql://host.docker.internal:5432/chatbot
# CLASSROOM-ONLY credentials of the L17 database. Prefer a read-only role (see
# docs/collegamento-database-vettoriale.md) and never reuse these values elsewhere.
VIZ_DB_USER=chatbot
VIZ_DB_PASSWORD=chatbot123
VIZ_DB_SCHEMA=public
VIZ_DB_TABLE=vector_store
VIZ_DB_STATEMENT_TIMEOUT=15s
VIZ_DB_CONNECTION_TIMEOUT=5s

# auto (from the index operator class), cosine, l2 or inner_product
VIZ_DISTANCE_METRIC=auto
# Above this number of chunks the 3D view shows a deterministic sample.
VIZ_MAX_POINTS=5000
VIZ_SNAPSHOT_MEMORY_BUDGET_MB=256

# --- "Simula una ricerca RAG" (optional) ----------------------------------------------------
VIZ_EMBEDDING_ENABLED=false
# OpenAI: https://api.openai.com/v1
# Ollama: http://host.docker.internal:11434/v1
# Docker Model Runner: http://model-runner.docker.internal/engines/v1
VIZ_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Must be the model used to index the table (L18 §12.1).
VIZ_EMBEDDING_MODEL=text-embedding-3-small
# Only for OpenAI. Leave empty here and put your key only in your local .env.
VIZ_EMBEDDING_API_KEY=
# Protects the (possibly paid) provider: calls per minute for the whole class.
VIZ_SEARCH_RATE_LIMIT_PER_MINUTE=10

# --- Publishing -------------------------------------------------------------------------
# 127.0.0.1 = only this computer. 0.0.0.0 shares the tool, and the documents, with the network.
VIZ_BIND_ADDRESS=127.0.0.1
VIZ_HTTP_PORT=8088

# --- Option B only: name of the L17 compose network (docker network ls) ----------------------
VIZ_L17_NETWORK=docker_default
